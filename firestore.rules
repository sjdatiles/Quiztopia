rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'sj.datiles.did@gmail.com'
      );
    }

    function isValidTeacher(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt']) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 200 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.role == 'teacher' &&
        data.createdAt is timestamp;
    }

    function isValidClass(data) {
      return data.keys().hasAll(['id', 'teacherId', 'name', 'gradeLevel', 'academicYearLabel', 'activeTermNumber', 'createdAt']) &&
        data.keys().hasOnly(['id', 'teacherId', 'name', 'gradeLevel', 'academicYearLabel', 'activeTermNumber', 'createdAt']) &&
        data.id is string && isValidId(data.id) &&
        data.teacherId is string && data.teacherId == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.gradeLevel is string && data.gradeLevel.size() >= 1 && data.gradeLevel.size() <= 40 &&
        data.academicYearLabel is string && data.academicYearLabel.size() >= 1 && data.academicYearLabel.size() <= 40 &&
        data.activeTermNumber is number && data.activeTermNumber >= 1 && data.activeTermNumber <= 3 &&
        data.createdAt is timestamp;
    }

    // Connectivity probe used on initial boot
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // Admin registry (bootstrap-only / read-only check)
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, write: if false;
    }

    // Teacher profiles (PII protected to owner or admin)
    match /teachers/{teacherId} {
      allow get: if isSignedIn() && isValidId(teacherId) && (request.auth.uid == teacherId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(teacherId) &&
        request.auth.uid == teacherId &&
        isValidTeacher(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isSignedIn() && isValidId(teacherId) &&
        (request.auth.uid == teacherId || isAdmin()) &&
        isValidTeacher(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email']);
      allow delete: if false;
    }

    // Classrooms (owner teacher only)
    match /classes/{classId} {
      allow get: if isSignedIn() && isValidId(classId) && (existing().teacherId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.teacherId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(classId) &&
        isValidClass(incoming()) &&
        incoming().id == classId &&
        incoming().createdAt == request.time;
      allow update: if isSignedIn() && isValidId(classId) &&
        (existing().teacherId == request.auth.uid || isAdmin()) &&
        isValidClass(incoming()) &&
        incoming().id == existing().id &&
        incoming().teacherId == existing().teacherId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'gradeLevel', 'academicYearLabel', 'activeTermNumber']);
      allow delete: if false;
    }

    // Server-authoritative collections: strictly managed by Express firebase-admin backend
    match /teams/{teamId} {
      allow get: if isSignedIn() && isValidId(teamId) && (existing().teacherId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.teacherId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /team_avatars/{teamId} {
      allow read, write: if false;
    }

    match /team_islands/{teamId} {
      allow read, write: if false;
    }

    match /team_wallets/{teamId} {
      allow read, write: if false;
    }

    match /coin_transactions/{txId} {
      allow read, write: if false;
    }

    match /creatures/{creatureId} {
      allow read, write: if false;
    }

    match /team_creatures/{docId} {
      allow read, write: if false;
    }

    match /catalog_items/{itemId} {
      allow read, write: if false;
    }

    match /team_inventory_items/{docId} {
      allow read, write: if false;
    }

    match /quizzes/{quizId} {
      allow get: if isSignedIn() && isValidId(quizId) && (existing().teacherId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.teacherId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /quiz_sessions/{sessionId} {
      allow get: if isSignedIn() && isValidId(sessionId) && (existing().teacherId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.teacherId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /quiz_participants/{docId} {
      allow read, write: if false;
    }

    match /team_answers/{answerId} {
      allow read, write: if false;
    }

    match /quiz_results/{resultId} {
      allow read, write: if false;
    }

    match /academic_terms/{termId} {
      allow read, write: if false;
    }

    match /term_rankings/{rankId} {
      allow read, write: if false;
    }

    match /achievements/{achId} {
      allow read, write: if false;
    }

    match /team_achievements/{docId} {
      allow read, write: if false;
    }

    match /config/{docId} {
      allow read, write: if false;
    }
  }
}
